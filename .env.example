# Copie para .env e preencha. O .env nao e versionado.
#
# Use senhas so com letras e numeros: elas entram em URLs de conexao, onde
# caracteres como @ : / % precisariam ser codificados.
# Para gerar uma: python -c "import secrets; print(secrets.token_hex(16))"

# --- Execucao local, fora do Docker -----------------------------------------
# Usada pelo CLI (python -m anp.pipeline) quando [destino] backend = "postgres"
# no config.toml, e pelos testes marcados com @pytest.mark.postgres. Os testes
# nao tocam no banco apontado aqui: criam um banco temporario no mesmo servidor
# e o removem ao final, por isso o usuario precisa da permissao CREATEDB.
#
# Para usar o Postgres do Compose, copie compose.override.example.yaml para
# compose.override.yaml e aponte para a porta publicada (padrao 15432).
# Use 127.0.0.1, nao localhost: o override publica so em IPv4, e o psycopg 3.3
# tenta ::1 primeiro e fica parado ate o timeout.
# DATABASE_URL=postgresql://anp:SENHA_ANP@127.0.0.1:15432/anp
DATABASE_URL=postgresql://usuario:senha@localhost:5432/anp

# --- Docker Compose: Postgres ------------------------------------------------
# Superusuario do servico postgres. Lido so na primeira subida, quando o
# volume esta vazio.
POSTGRES_PASSWORD=troque-me
# Senhas dos usuarios airflow (database airflow) e anp (database anp), criados
# por docker/postgres/init/01-bancos.sh na primeira subida.
AIRFLOW_DB_PASSWORD=troque-me
ANP_DB_PASSWORD=troque-me
# Porta do Postgres no host, so com compose.override.yaml.
ANP_PG_PORTA_LOCAL=15432

# --- Docker Compose: Airflow -------------------------------------------------
# Conexao do pipeline com o banco anp vista de dentro dos containers (host
# "postgres"). A senha e a mesma de ANP_DB_PASSWORD. Fica separada de
# DATABASE_URL acima porque o host muda dentro e fora do Docker.
ANP_DATABASE_URL=postgresql://anp:troque-me@postgres:5432/anp
# Chave que cifra conexoes e variaveis no banco de metadados. Gere com:
# python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=
# Segredo que assina os tokens JWT da API do Airflow. Gere com:
# python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_JWT_SECRET=
# Usuario admin da interface web, criado pelo airflow-init.
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=troque-me
