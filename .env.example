# Copie para .env e preencha. O .env nao e versionado.
#
# Usada quando [destino] backend = "postgres" no config.toml e pelos testes
# marcados com @pytest.mark.postgres. Os testes nao tocam no banco apontado
# aqui: criam um banco temporario no mesmo servidor e o removem ao final, por
# isso o usuario precisa da permissao CREATEDB.
DATABASE_URL=postgresql://usuario:senha@localhost:5432/anp
